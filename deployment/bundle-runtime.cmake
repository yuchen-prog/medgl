cmake_minimum_required(VERSION 3.25)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
foreach(required INPUT_DIR OUTPUT_DIR CUDA_BIN DUMPBIN)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing runtime packaging parameter: ${required}")
    endif()
endforeach()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${DUMPBIN}")
file(TO_CMAKE_PATH "$ENV{SystemRoot}" system_root)
set(system_pattern "^")
string(LENGTH "${system_root}" root_length)
math(EXPR root_last "${root_length} - 1")
foreach(index RANGE ${root_last})
    string(SUBSTRING "${system_root}" ${index} 1 character)
    if(character MATCHES "[A-Za-z]")
        string(TOLOWER "${character}" lower)
        string(TOUPPER "${character}" upper)
        string(APPEND system_pattern "[${lower}${upper}]")
    else()
        string(APPEND system_pattern "${character}")
    endif()
endforeach()
string(APPEND system_pattern "/")
set(executables)
foreach(name medgl_server medgl_cli medgl_cuda_probe medgl_dicom_audit medgl_vr_benchmark)
    list(APPEND executables "${INPUT_DIR}/${name}.exe")
endforeach()
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${executables}
    DIRECTORIES "${INPUT_DIR}" "${CUDA_BIN}" "${CUDA_BIN}/x64"
    PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
    POST_EXCLUDE_REGEXES "${system_pattern}"
    RESOLVED_DEPENDENCIES_VAR resolved
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicts)
if(unresolved OR conflicts_FILENAMES)
    message(FATAL_ERROR "Unresolved or conflicting runtime dependencies: ${unresolved}; ${conflicts_FILENAMES}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/bin")
file(COPY ${executables} DESTINATION "${OUTPUT_DIR}/bin")
foreach(dependency IN LISTS resolved)
    file(COPY "${dependency}" DESTINATION "${OUTPUT_DIR}/bin")
endforeach()
file(WRITE "${OUTPUT_DIR}/system-dependencies.txt"
    "External prerequisites: Windows x64 system APIs, NVIDIA display driver, Microsoft Visual C++ v14 x64 Runtime.\nSystem-directory DLLs and API sets are excluded before dependency recursion; they are not bundled.\n")